<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application>
        <provider android:name=".WorldSessionProvider"
            android:authorities="${applicationId}.world-session"
            android:enabled="${minepilotNodeSmoke}" android:exported="false" android:process=":friend_world" />
        <service android:name=".XboxSignInService"
            android:enabled="${minepilotNodeSmoke}" android:exported="false"
            android:foregroundServiceType="dataSync" android:process=":friend_world" />
        <activity android:name=".XboxAuthProbeActivity" android:enabled="${minepilotNodeSmoke}" android:exported="false" android:process=":friend_world"/>
        <activity android:name=".NodeSmokeActivity"
            android:enabled="${minepilotNodeSmoke}"
            android:exported="${minepilotNodeSmoke}"
            android:label="MinePilot Node Runtime Test"
            android:process=":node_smoke">
        </activity>
    </application>
</manifest>
